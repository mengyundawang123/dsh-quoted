{
  "name": "dsh-quoted",
  "version": "0.1.0",
  "type": "module",
  "description": "Quote a passage in a DSH conversation: it becomes a temporary annotation file attached to the composer as a reference chip, and is deleted once the turn reads it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengyundawang123/dsh-quoted.git"
  },
  "homepage": "https://github.com/mengyundawang123/dsh-quoted#readme",
  "bugs": {
    "url": "https://github.com/mengyundawang123/dsh-quoted/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "annotation",
    "quote",
    "context"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tests/*.mjs"
  ],
  "scripts": {
    "test": "node tests/host.test.mjs && node tests/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
